# Purchase Shipment Alert — backend configuration.
# LOCAL DEVELOPMENT values. Before production flip the hardening flags:
#   NODE_ENV=production  FORCE_HTTPS=true  ENABLE_HSTS=true
#   SESSION_COOKIE_SECURE=true  SQL_ENCRYPT=true  TRUST_PROXY_HOPS=<proxies>
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4340
# Comma separated list of origins allowed to call the API (the Flutter web app).
FRONTEND_ORIGINS=http://127.0.0.1:5340,http://localhost:5340
# Link put in the daily email ("open the system").
APP_PUBLIC_URL=http://127.0.0.1:5340

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The two MUST be different values.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h
SESSION_SECRET=change-this-to-a-DIFFERENT-long-random-secret
SESSION_COOKIE_NAME=psa_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=strict
SESSION_IDLE_TIMEOUT_MINUTES=30
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=5
FORCE_HTTPS=false
ENABLE_HSTS=false
TRUST_PROXY_HOPS=0

SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=Purchase_Alert
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# SMTP — leave blank and every mail is kept in email_outbox as pending_config.
# Office 365 example: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to false to stop the 08:30 daily / month-end mail scheduler in this process.
MAIL_SCHEDULER_ENABLED=true
