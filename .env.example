# Purchase Shipment Alert — backend configuration.
# LOCAL DEVELOPMENT values. Before production flip the hardening flags:
#   NODE_ENV=production  FORCE_HTTPS=true  ENABLE_HSTS=true
#   SESSION_COOKIE_SECURE=true  SQL_ENCRYPT=true  TRUST_PROXY_HOPS=<proxies>
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4340
# Comma separated list of origins allowed to call the API (the Flutter web app).
FRONTEND_ORIGINS=http://127.0.0.1:5340,http://localhost:5340
# Link put in the daily email ("open the system").
APP_PUBLIC_URL=http://127.0.0.1:5340

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The two MUST be different values.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h
SESSION_SECRET=change-this-to-a-DIFFERENT-long-random-secret
SESSION_COOKIE_NAME=psa_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=strict
SESSION_IDLE_TIMEOUT_MINUTES=15
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=5
FORCE_HTTPS=false
ENABLE_HSTS=false
TRUST_PROXY_HOPS=0

SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=Purchase_Alert
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# SMTP — leave blank and every mail is kept in email_outbox as pending_config.
# Office 365 example: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# External read-only holiday DB, shared with RAP (SAR · Master_Holiday.HolidayDate).
# Leave HOLIDAY_SQL_SERVER blank to use only the holidays entered in Settings › Holidays.
HOLIDAY_SQL_SERVER=
HOLIDAY_SQL_PORT=1433
HOLIDAY_SQL_DATABASE=SAR
HOLIDAY_SQL_USER=
HOLIDAY_SQL_PASSWORD=
HOLIDAY_SQL_TABLE=Master_Holiday
HOLIDAY_SQL_DATE_COLUMN=HolidayDate
HOLIDAY_SQL_ENCRYPT=false
HOLIDAY_SQL_TRUST_SERVER_CERTIFICATE=true

# Sign in with Microsoft 365 (Entra ID). Leave any of the four blank and the
# button is simply not shown. App registration (Entra admin center › App
# registrations › New registration):
#   - Supported account types: this organisational directory only
#   - Redirect URI (platform "Web"): exactly MS_REDIRECT_URI below
#   - Certificates & secrets › New client secret -> MS_CLIENT_SECRET (the Value)
#   - API permissions: Microsoft Graph openid, profile, email (delegated)
# Only people who already exist (same email, active) on the Users page get in.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://127.0.0.1:4340/api/auth/microsoft/callback

# Production: serve the Flutter release build from this API (one origin, the
# web app's CSP set here). Path relative to backend/. Leave blank in dev.
# Build it with:  flutter build web --release --csp --no-web-resources-cdn
WEB_ROOT=

# Set to false to stop the 08:30 daily / month-end mail scheduler in this process.
MAIL_SCHEDULER_ENABLED=true
